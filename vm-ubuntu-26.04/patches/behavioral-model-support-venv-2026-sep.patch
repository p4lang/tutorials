 cmake .. -DCMAKE_INSTALL_PREFIX=/usr
 cmake --build .
+dump_python_lib_info "${DEBUG_DUMP_DIR}/033b-behavioral-model-just-before-nanomsg-cmake-install"
 sudo cmake --build . --target install
+dump_python_lib_info "${DEBUG_DUMP_DIR}/033c-behavioral-model-just-after-nanomsg-cmake-install"
